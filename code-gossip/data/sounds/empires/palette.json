  "cast": {
    "worker": {
      "seed": 272,
      "text": "Ready for work! Bring the timber! Raise the walls. Stone by stone! There is work to do!",
      "instruct": "A fictional medieval peasant worker in a 1990s real time strategy game. Male coarse nasal tenor, strongly exaggerated rural southern English accent, rough throaty grain, pinched forward vowels and hard consonants. Boisterous, cheeky, slightly grumpy. Bark every short line loudly with huge changes of pitch: jump up at the start, snap down at the end. Energetic compact staccato pace, eager and overacted, like shouting across a noisy building site. Dry isolated studio voice. No music, no background effects, no narrator smoothness.",
      "reference": "references/worker.flac"
    },
    "scout": {
      "seed": 422,
      "text": "At the ready! Beyond the hills! I see the road. Ride with me! Our scouts bring word!",
      "instruct": "A fictional female frontier scout in a 1990s strategy game. Rough husky mid-low alto, very raspy chest voice with a pronounced northern British accent. Wildly animated, bold and mischievous, almost a battle cry. Bark each short call with exaggerated rising and falling pitch, hard clipped consonants, and fierce emphasis on the action. Loud confident projected delivery, urgent quick pace. Dry isolated studio voice. No background sounds, no narrator smoothness.",
      "reference": "references/scout.flac"
    },
    "commander": {
      "seed": 834,
      "text": "Raise the banner! The road is ours! Let the campaign begin. Forward, together! Make every move count!",
      "instruct": "A fictional male strategy game taunt commander. Deep coarse gritty baritone, raspy chest resonance and a broad American accent. Swaggering, overconfident, bombastic and humorously theatrical. Bark each line with fierce emphasis and big rises and falls in pitch, sharp hard attacks and decisive falling ends. Almost shouting, with a growling edge and a laugh in the voice. Short explosive delivery, brisk and energized. Dry isolated studio voice, no music or environmental noise, no smooth narration.",
      "reference": "references/commander.flac"
    },
    "scholar": {
      "seed": 948,
      "text": "Open the scrolls. A wise choice! The old paths guide us. Read the signs! Wisdom will prevail.",
      "instruct": "A fictional eccentric medieval monk from a 1990s strategy game. Older male dark bass with grainy hoarse resonance, quavering rough edges, strongly rolled resonant vowels and a broad British accent. Comically solemn, wildly theatrical and very expressive. Pronounce each short call with a large musical rise and fall, a strong chesty attack and a chant-like rounded ending. Project loudly and briskly, never whisper or drag out the phrase. Dry isolated studio voice, no music or background effects, no calm narration.",
      "reference": "references/scholar.flac"
    }
  },
